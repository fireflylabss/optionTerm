+                        else if (k == "t") t_medium = v;
+                        else if (k == "i") id = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        else if (k == "I") number = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        else if (k == "p") placement_id = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        else if (k == "z") z = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        else if (k == "x") x = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        else if (k == "y") y = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        else if (k == "c") cols = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        else if (k == "r") rows = std::strtol(std::string{v}.c_str(), nullptr, 0);
