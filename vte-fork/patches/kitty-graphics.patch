+                auto const image = std::find_if(m_kitty_images.begin(),
+                                                m_kitty_images.end(),
+                                                [image_id = placement.image_id](auto const& img) {
+                                                        return img.id == image_id;
+                                                });
+                if (image == m_kitty_images.end())
+                        continue;
+
+                auto const x = m_border.left + placement.col * m_cell_width;
+                auto const y = row_to_pixel(placement.row);
+                auto const width = placement.cols * m_cell_width;
+                auto const height = placement.rows * m_cell_height;
+
+                m_draw.draw_pixbuf(image->pixbuf, x, y, width, height);
+        }
+}
