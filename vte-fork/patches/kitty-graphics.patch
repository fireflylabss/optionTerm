 void
+Terminal::add_kitty_placement(int image_id,
+                             int placement_id,
+                             long row,
+                             long col,
+                             int cols,
+                             int rows,
+                             int z) noexcept
+{
+        // Same image+placement id replaces the previous one (protocol spec).
+        auto const it = std::find_if(m_kitty_placements.begin(),
+                                     m_kitty_placements.end(),
+                                     [image_id, placement_id](auto const& p) {
+                                             return p.image_id == image_id
+                                                     && p.placement_id == placement_id;
+                                     });
+        if (it != m_kitty_placements.end()) {
+                auto const top = std::min(it->row, row);
+                auto const bottom = std::max(it->row + std::max(it->rows, 1) - 1,
+                                             row + std::max(rows, 1) - 1);
+                it->row = row;
+                it->col = col;
+                it->cols = cols;
+                it->rows = rows;
+                it->z = z;
+                invalidate_rows_and_context(top, bottom);
+                return;
+        }
+        m_kitty_placements.push_back(KittyPlacement{image_id, placement_id, row, col, cols, rows, z});
+        invalidate_rows_and_context(row, row + std::max(rows, 1) - 1);
+}
+
+void
+Terminal::delete_kitty_placement(int image_id, int placement_id) noexcept
+{
+        auto const it = std::find_if(m_kitty_placements.begin(),
+                                     m_kitty_placements.end(),
+                                     [image_id, placement_id](auto const& p) {
+                                             return p.image_id == image_id
+                                                     && (placement_id == 0 || p.placement_id == placement_id);
+                                     });
+        if (it == m_kitty_placements.end())
+                return;
+        auto const top = it->row;
+        auto const bottom = it->row + std::max(it->rows, 1) - 1;
+        m_kitty_placements.erase(it);
+        invalidate_rows_and_context(top, bottom);
+}
+
+void
+Terminal::delete_kitty_placements_by_number(int number) noexcept
+{
+        if (m_kitty_placements.empty())
+                return;
+        auto top = m_kitty_placements.front().row;
+        auto bottom = m_kitty_placements.back().row + std::max(m_kitty_placements.back().rows, 1) - 1;
+        // The image number maps to the newest image with that number.
+        int matched_id = -1;
+        for (auto const& img : m_kitty_images) {
+                if (img.number == number)
+                        matched_id = img.id;
+        }
+        if (matched_id >= 0) {
+                m_kitty_placements.erase(
+                        std::remove_if(m_kitty_placements.begin(),
+                                       m_kitty_placements.end(),
+                                       [matched_id](auto const& p) { return p.image_id == matched_id; }),
+                        m_kitty_placements.end());
+                m_kitty_images.erase(
+                        std::remove_if(m_kitty_images.begin(),
+                                       m_kitty_images.end(),
+                                       [matched_id](auto const& img) { return img.id == matched_id; }),
+                        m_kitty_images.end());
+        }
+        invalidate_rows_and_context(top, bottom);
+}
+
+void
+Terminal::clear_kitty_placements() noexcept
+{
+        if (m_kitty_placements.empty())
+                return;
+        auto top = m_kitty_placements.front().row;
+        auto bottom = m_kitty_placements.back().row + std::max(m_kitty_placements.back().rows, 1) - 1;
+        m_kitty_placements.clear();
+        invalidate_rows_and_context(top, bottom);
+}
