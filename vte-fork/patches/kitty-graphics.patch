+         * Used for the kitty graphics protocol: the payload has the form
+         *   G <key>=<value>[,...];<data>
+         * and the whole thing is terminated by ST.
+         *
+         * References: kitty graphics protocol
+         *   https://sw.kovidgoyal.net/kitty/graphics-protocol/
+         *
+         * The parsing/decode/reply structure here was written independently
+         * for optionTerm but is informed by the protocol handling in
+         * FoxTerminal's forked VTE (https://gitlab.com/OrangeFox/misc/
+         * foxterminal-vte), by Christian Persch — notably the ideas that a
+         * query should carry out the transmission and report what happened,
+         * that chunked payloads should be joined before decoding, and that
+         * image memory should be a bounded, evicting budget.
+         */
+
+        if (!m_enable_inline_images)
+                return;
+
+        auto const u32str = seq.string();
+        if (u32str.empty())
+                return;
+
+        auto str = std::string{};
+        str.resize_and_overwrite
+                (simdutf::utf8_length_from_utf32(u32str),
+                 [&](char* data,
+                     size_t data_size) constexpr noexcept -> size_t {
+                         return simdutf::convert_utf32_to_utf8
+                                 (u32str, std::span<char>(data, data_size));
+                 });
+
+        // Expect the "G" introducer, then "key=value,..." then optional ";data".
+        if (str.size() < 2 || str[0] != 'G')
+                return;
+
+        auto const params_end = str.find(';');
+        auto const params = params_end == std::string::npos
+                ? std::string_view{str}.substr(1)
+                : std::string_view{str}.substr(1, params_end - 1);
+        auto const data = params_end == std::string::npos
+                ? std::string_view{}
+                : std::string_view{str}.substr(params_end + 1);
+
+        // Chunked transmission (m=1): the first chunk carries the keys, the
+        // rest is raw payload; the m=0 chunk is the last. Join the chunks
+        // while still base64-encoded, so a client may split its base64
+        // anywhere without losing bytes at the seam.
+        auto const more = [&]() -> long {
+                size_t pos = 0;
+                while (pos <= params.size()) {
+                        auto const comma = params.find(',', pos);
+                        auto const kv = comma == std::string_view::npos
+                                ? params.substr(pos)
+                                : params.substr(pos, comma - pos);
+                        if (auto const eq = kv.find('='); eq != std::string_view::npos) {
+                                auto const k = kv.substr(0, eq);
+                                auto const v = kv.substr(eq + 1);
+                                if (k == "m")
+                                        return std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        }
+                        if (comma == std::string_view::npos)
+                                break;
+                        pos = comma + 1;
+                }
+                return 0L;
+        }();
+
+        if (more == 1) {
+                if (m_kitty_chunk_keys.empty())
+                        m_kitty_chunk_keys = std::string{params};
+                if (m_kitty_chunk_payload.size() + data.size() > VTE_KITTY_IMAGE_MAX) {
+                        // Runaway transmission: refuse it rather than grow
+                        // forever, and say so — silence would leave the
+                        // client waiting on an image that never arrives.
+                        auto const all_keys = m_kitty_chunk_keys;
+                        m_kitty_chunk_keys.clear();
+                        m_kitty_chunk_payload.clear();
+                        kitty_graphics_reply(all_keys, "EINVAL:transmission too large");
+                        return;
+                }
+                m_kitty_chunk_payload += data;
+                return;
+        }
+
+        if (!m_kitty_chunk_keys.empty()) {
+                auto const all_keys = m_kitty_chunk_keys;
+                auto const all_data = m_kitty_chunk_payload + std::string{data};
+                m_kitty_chunk_keys.clear();
+                m_kitty_chunk_payload.clear();
+                kitty_graphics_command(seq, all_keys, all_data);
+                return;
+        }
+
+        kitty_graphics_command(seq, params, data);
+}
+catch (...)
+{
+        /* Never let the terminal die because of malformed image data. */
+}
+
+// Send a kitty graphics protocol reply to the child. The message is either
+// "OK" or an error such as "EINVAL:unsupported format". q=1 suppresses the
+// success reply, q=2 suppresses failures too, and a command with no image id
+// has nothing a reply could name, so it stays silent.
+void
+Terminal::kitty_graphics_reply(std::string_view keys,
+                               std::string const& message) noexcept
+{
+        auto reply_id = 0;
+        auto quiet = 0;
+        {
+                size_t pos = 0;
+                while (pos <= keys.size()) {
+                        auto const comma = keys.find(',', pos);
+                        auto const kv = comma == std::string_view::npos
+                                ? keys.substr(pos)
+                                : keys.substr(pos, comma - pos);
+                        auto const eq = kv.find('=');
+                        if (eq != std::string_view::npos) {
+                                auto const k = kv.substr(0, eq);
+                                auto const v = kv.substr(eq + 1);
+                                if (k == "i")
+                                        reply_id = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "q")
+                                        quiet = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        }
+                        if (comma == std::string_view::npos)
+                                break;
+                        pos = comma + 1;
+                }
+        }
+
+        auto const ok = message == "OK";
+        if (reply_id == 0 || quiet >= 2 || (ok && quiet >= 1))
+                return;
+
+        // Per the kitty spec the reply is `ESC _ Gi=<id>;{OK|error} ESC \`.
+        // Written straight to the PTY so the terminal answers even while the
+        // window is unfocused / input is disabled.
+        auto builder = vte::parser::u8SequenceBuilder{VTE_SEQ_APC};
+        builder.format("Gi={};{}", reply_id, message);
+        std::string reply_str;
+        builder.to_string(reply_str, false, -1,
+                          vte::parser::u8SequenceBuilder::Introducer::DEFAULT,
+                          vte::parser::u8SequenceBuilder::ST::DEFAULT);
+        _vte_byte_array_append(m_outgoing, reply_str.data(), reply_str.size());
+        connect_pty_write();
+}
+
+// Handle one kitty graphics command (after any chunk reassembly). This is the
+// workhorse: it transmits, decodes and places images, answers queries by
+// actually carrying the transmission out, and reports what happened.
+void
+Terminal::kitty_graphics_command(vte::parser::Sequence const& seq,
+                                 std::string_view keys,
+                                 std::string_view encoded) noexcept
+try
+{
+        (void)seq;
+
+        // Re-parse the keys the same way the entry point does; commands handed
+        // a reassembled chunk arrive here with the first chunk's keys.
+        auto action = std::string_view{"t"};
+        auto f = -1;
+        auto t_medium = std::string_view{"d"};
+        auto id = -1;
+        auto number = -1;
+        auto placement_id = 0;
+        auto z = 0;
+        auto x = 0;
+        auto y = 0;
+        auto cols = 0;
+        auto rows = 0;
+        auto width = 0;
+        auto height = 0;
+        auto compression = std::string_view{" "};
+        auto del_target = std::string_view{"a"};
+        auto cursor_move = 0;
+
+        {
+                size_t pos = 0;
+                while (pos <= keys.size()) {
+                        auto const comma = keys.find(',', pos);
+                        auto const kv = comma == std::string_view::npos
+                                ? keys.substr(pos)
+                                : keys.substr(pos, comma - pos);
+                        auto const eq = kv.find('=');
+                        if (eq != std::string_view::npos) {
+                                auto const k = kv.substr(0, eq);
+                                auto const v = kv.substr(eq + 1);
+                                if (k == "a") action = v;
+                                else if (k == "f") f = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "t") t_medium = v;
+                                else if (k == "i") id = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "I") number = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "p") placement_id = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "z") z = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "x") x = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "y") y = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "c") cols = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "r") rows = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "s") width = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "v") height = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                                else if (k == "o") compression = v;
+                                else if (k == "d") del_target = v;
+                                else if (k == "C") cursor_move = std::strtol(std::string{v}.c_str(), nullptr, 0);
+                        }
+                        if (comma == std::string_view::npos)
+                                break;
+                        pos = comma + 1;
+                }
+        }
+
+        // Resolve the image id: an explicit i= wins, otherwise I= (image
+        // number) refers to the newest image carrying that number.
+        auto resolve_id = [&](int num) -> int {
+                if (num < 0)
+                        return -1;
+                int matched = -1;
+                for (auto const& img : m_kitty_images) {
+                        if (img.number == num)
+                                matched = img.id;
+                }
+                return matched;
+        };
+        auto const effective_id = id >= 0 ? id : resolve_id(number);
+
+        // A query answers by carrying out the whole transmission and reporting
+        // what really happened (and keeping nothing), so a client learns the
+        // truth about whether a medium/format works rather than a capability
+        // name we might not be able to reach the data through.
+        auto const query_only = action == "q";
+
+        auto ok = true;
+        auto message = std::string{"OK"};
+
+        switch (action[0]) {
+        case 'd':
+                if (del_target == "a" || del_target == "A") {
+                        clear_kitty_placements();
+                } else if (del_target == "n" || del_target == "N") {
+                        if (number >= 0)
+                                delete_kitty_placements_by_number(number);
+                        else if (effective_id >= 0)
+                                delete_kitty_placement(effective_id, placement_id);
+                } else if (effective_id >= 0) {
+                        delete_kitty_placement(effective_id, placement_id);
+                }
+                break;
+
+        case 'p': {
+                auto const image_id = effective_id;
+                if (image_id < 0 || cols <= 0 || rows <= 0) {
+                        ok = false;
+                        message = "ENOENT:no such image";
+                        break;
+                }
+                auto const row = m_screen->cursor.row + y;
+                auto const col = m_screen->cursor.col + x;
+                add_kitty_placement(image_id, placement_id, row, col, cols, rows, z);
+                break;
+        }
+
+        case 'q':
+        case 't':
+        case 'T': {
+                if ((t_medium != "d" && t_medium != "f") || encoded.empty()) {
+                        ok = false;
+                        message = "EINVAL:unsupported transmission medium";
+                        break;
+                }
+
+                gsize decoded_len = 0;
+                auto decoded = g_base64_decode(std::string{encoded}.c_str(), &decoded_len);
+                if (decoded == nullptr || decoded_len == 0) {
+                        ok = false;
+                        message = "EINVAL:could not decode base64";
+                        break;
+                }
+
+                // The pixel payload, once any o=z deflate is reversed.
+                std::string pixels(reinterpret_cast<char const*>(decoded), decoded_len);
+                g_free(decoded);
+
+                if (compression == "z") {
+                        pixels = kitty_inflate(std::move(pixels),
+                                               (f == 100) ? size_t{0}
+                                                          : size_t(width) * size_t(height) * size_t(f == 24 ? 3 : 4));
+                        if (pixels.empty()) {
+                                ok = false;
+                                message = "EINVAL:could not decompress";
+                                break;
+                        }
+                }
+
+                GdkPixbuf* pixbuf = kitty_pixbuf(std::move(pixels), f, width, height,
+                                                 t_medium == "f");
+                if (pixbuf == nullptr) {
+                        ok = false;
+                        message = "EINVAL:could not decode image";
+                        break;
+                }
+
+                // Everything a query can fail at has now succeeded; it keeps
+                // nothing (no image, no id, no placement).
+                if (query_only) {
+                        g_object_unref(pixbuf);
+                        break;
+                }
+
+                // Assign a concrete image id if the client used a number (I=).
+                int image_id = id;
+                if (image_id < 0) {
+                        image_id = 1;
+                        for (auto const& img : m_kitty_images)
+                                image_id = std::max(image_id, img.id + 1);
+                }
+
+                auto const pixels_size = size_t(gdk_pixbuf_get_rowstride(pixbuf))
+                        * size_t(gdk_pixbuf_get_height(pixbuf));
+                if (!kitty_gc(pixels_size)) {
+                        g_object_unref(pixbuf);
+                        ok = false;
+                        message = "ENOSPC:not enough image memory";
+                        break;
+                }
+
+                // Replace or add the image with this id.
+                auto const it = std::find_if(m_kitty_images.begin(),
+                                             m_kitty_images.end(),
+                                             [image_id](auto const& img) {
+                                                     return img.id == image_id;
+                                             });
+                if (it != m_kitty_images.end()) {
+                        g_object_unref(it->pixbuf);
+                        it->pixbuf = pixbuf;
+                        it->number = number;
+                        it->width = gdk_pixbuf_get_width(pixbuf);
+                        it->height = gdk_pixbuf_get_height(pixbuf);
+                } else {
+                        m_kitty_images.push_back(KittyImage{
+                                image_id,
+                                number,
+                                pixbuf,
+                                gdk_pixbuf_get_width(pixbuf),
+                                gdk_pixbuf_get_height(pixbuf),
+                        });
+                }
+                m_kitty_images_memory_used += pixels_size;
+
+                if (action == "T" && cols > 0 && rows > 0) {
+                        auto const row = m_screen->cursor.row + y;
+                        auto const col = m_screen->cursor.col + x;
+                        add_kitty_placement(image_id, placement_id, row, col, cols, rows, z);
+                        if (cursor_move == 0) {
+                                m_screen->cursor.col += cols;
+                                while (m_screen->cursor.col >= m_column_count) {
+                                        m_screen->cursor.col -= m_column_count;
+                                        m_screen->cursor.row++;
+                                }
+                        }
+                }
+                break;
+        }
+
+        default:
+                ok = false;
+                message = "EINVAL:unknown action";
+                break;
+        }
+
+        kitty_graphics_reply(keys, ok ? "OK" : message);
+}
+catch (...)
+{
+        /* Never let the terminal die because of malformed image data. */
+}
+
+// Decode a kitty pixel payload into a GdkPixbuf. PNG (f=100) is decoded by
+// gdk-pixbuf; the raw formats f=24 (RGB) and f=32 (RGBA) are packed directly.
+// When @from_file is set the payload is a filesystem path, otherwise it is
+// in-band pixel data.
+GdkPixbuf*
+Terminal::kitty_pixbuf(std::string&& data,
+                       int format,
+                       int width,
+                       int height,
+                       bool from_file) noexcept
+try
+{
+        if (from_file) {
+                if (data.empty())
+                        return nullptr;
+                struct stat st {};
+                if (stat(data.c_str(), &st) != 0 || !S_ISREG(st.st_mode))
+                        return nullptr;
+                if (g_str_has_prefix(data.c_str(), "/proc")
+                    || g_str_has_prefix(data.c_str(), "/sys")
+                    || g_str_has_prefix(data.c_str(), "/dev"))
+                        return nullptr;
+                GError* error = nullptr;
+                auto pixbuf = gdk_pixbuf_new_from_file(data.c_str(), &error);
+                if (error != nullptr)
+                        g_error_free(error);
+                return pixbuf;
+        }
+
+        if (format == 100) {
+                auto const stream = g_memory_input_stream_new_from_data
+                        (g_memdup2(data.data(), data.size()), gssize(data.size()), g_free);
+                GError* error = nullptr;
+                auto pixbuf = gdk_pixbuf_new_from_stream(stream, nullptr, &error);
+                g_object_unref(stream);
+                if (error != nullptr)
+                        g_error_free(error);
+                return pixbuf;
+        }
+
+        if (format != 24 && format != 32)
+                return nullptr;
+
+        if (width <= 0 || height <= 0 || width > VTE_KITTY_MAX_WIDTH || height > VTE_KITTY_MAX_HEIGHT)
+                return nullptr;
+
+        auto const channels = (format == 24) ? 3 : 4;
+        if (data.size() < size_t(width) * size_t(height) * size_t(channels))
+                return nullptr;
+
+        // gdk_pixbuf_new_from_data takes ownership of the buffer, so copy the
+        // string's bytes into a g_malloc'd block (the string is a local that
+        // will go away when we return).
+        auto owned = static_cast<guchar*>(g_memdup2(data.data(), data.size()));
+        return gdk_pixbuf_new_from_data(
+                owned,
+                GDK_COLORSPACE_RGB,
+                format == 32,
+                8,
+                width,
+                height,
+                width * channels,
+                [](guchar* pixels, void*) { g_free(pixels); },
+                nullptr);
+}
+catch (...)
+{
+        return nullptr;
+}
+
+// Reverse a zlib stream (o=z). Bounded by @expected when the format fixes the
+// decompressed size, and by VTE_KITTY_IMAGE_MAX when it does not (PNG).
+std::string
+Terminal::kitty_inflate(std::string&& in, size_t expected) noexcept
+try
+{
+        auto const limit = expected ? expected : size_t(VTE_KITTY_IMAGE_MAX);
+
+        auto decompressor = vte::glib::take_ref(
+                G_CONVERTER(g_zlib_decompressor_new(G_ZLIB_COMPRESSOR_FORMAT_ZLIB)));
+        auto out = std::string{};
+        out.resize(expected ? limit
+                            : std::min(limit, std::max(in.size() * 4 + 1024, size_t(64u << 10))));
+
+        auto consumed = gsize{0};
+        auto produced = gsize{0};
+
+        for (;;) {
+                auto read = gsize{0}, written = gsize{0};
+                auto err = vte::glib::Error{};
+                auto const rv = g_converter_convert(decompressor.get(),
+                                                    in.data() + consumed, in.size() - consumed,
+                                                    out.data() + produced, out.size() - produced,
+                                                    G_CONVERTER_INPUT_AT_END,
+                                                    &read, &written,
+                                                    err);
+                consumed += read;
+                produced += written;
+
+                if (rv == G_CONVERTER_FINISHED)
+                        break;
+
+                if (rv == G_CONVERTER_CONVERTED && produced < out.size())
+                        continue;
+
+                if (rv == G_CONVERTER_CONVERTED ||
+                    err.matches(G_IO_ERROR, G_IO_ERROR_NO_SPACE)) {
+                        if (out.size() >= limit)
+                                return {};
+                        out.resize(std::min(limit, out.size() * 2));
+                        continue;
+                }
+
+                return {};
+        }
+
+        out.resize(produced);
+        return out;
+}
+catch (...)
+{
+        return {};
+}
+
+// Make room for an incoming image under VTE_KITTY_MEMORY_MAX, evicting the
+// least-recently-used images first. Returns false when the image is too large
+// to ever fit even with the table empty.
+bool
+Terminal::kitty_gc(size_t incoming) noexcept
+{
+        if (incoming > VTE_KITTY_MEMORY_MAX)
+                return false;
+
+        while (m_kitty_images_memory_used + incoming > VTE_KITTY_MEMORY_MAX
+               && !m_kitty_images.empty()) {
+                // Drop the oldest image (images are kept in insertion order).
+                auto victim = m_kitty_images.begin();
+                auto victim_id = victim->id;
+                auto victim_size = size_t(gdk_pixbuf_get_rowstride(victim->pixbuf))
+                        * size_t(gdk_pixbuf_get_height(victim->pixbuf));
+                m_kitty_images_memory_used -= victim_size;
+                g_object_unref(victim->pixbuf);
+                m_kitty_images.erase(victim);
+                // Its placements are now dangling; clear them so nothing draws
+                // a freed pixbuf.
+                m_kitty_placements.erase(
+                        std::remove_if(m_kitty_placements.begin(),
+                                       m_kitty_placements.end(),
+                                       [victim_id](auto const& p) { return p.image_id == victim_id; }),
+                        m_kitty_placements.end());
+        }
+        return true;
+}
+
+void
 Terminal::DECSKCV(vte::parser::Sequence const& seq)
 {
         /*
