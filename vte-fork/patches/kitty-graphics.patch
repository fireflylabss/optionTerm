+                          int width,
+                          int height) const
+{
+        auto cr = begin_cairo(x, y, width, height);
+
+        auto const scale_x = (double)width / gdk_pixbuf_get_width(pixbuf);
+        auto const scale_y = (double)height / gdk_pixbuf_get_height(pixbuf);
